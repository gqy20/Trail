{
  "name": "trail",
  "version": "0.2.0",
  "description": "Trail Chrome extension for recording research sessions from tab groups.",
  "private": true,
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run version:check && tsc --noEmit && vite build && vite build --config vite.content.config.ts",
    "version:check": "node scripts/version.mjs check",
    "version:sync": "node scripts/version.mjs sync",
    "version": "npm run version:sync",
    "check": "npm run build",
    "test:checkin": "npm run build && playwright test",
    "install-hooks": "node scripts/install-hooks.mjs",
    "preview": "vite preview --host 127.0.0.1"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@fontsource-variable/noto-sans-sc": "^5.3.0",
    "lucide-react": "^1.23.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-markdown": "^10.1.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/chrome": "^0.2.2",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "typescript": "^7.0.2",
    "vite": "^8.1.3"
  }
}

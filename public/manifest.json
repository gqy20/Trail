{
  "manifest_version": 3,
  "name": "Trail",
  "description": "Capture a Chrome tab group as a research trail.",
  "version": "0.1.0",
  "action": {
    "default_title": "Trail",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["tabs", "tabGroups", "storage"],
  "icons": {
    "16": "icons/icon-16.svg",
    "48": "icons/icon-48.svg",
    "128": "icons/icon-128.svg"
  }
}

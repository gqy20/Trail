#!/bin/bash
# Git pre-commit hook: verify commit-msg hook and run focused project checks.
# Install: npm run install-hooks

set -euo pipefail

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

PASS=true
HOOKS_DIR="$(git rev-parse --git-path hooks)"

if [ ! -x "$HOOKS_DIR/commit-msg" ]; then
  echo -e "${RED}commit-msg hook 未安装，无法校验提交信息规范。${NC}"
  echo -e "${YELLOW}请执行: npm run install-hooks${NC}"
  PASS=false
else
  echo -e "${GREEN}commit-msg hook 已安装，将校验提交信息规范${NC}"
fi

STAGED_PROJECT_FILES="$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(ts|tsx|css|html|json)$|^(vite.config.ts|tsconfig.json|package-lock.json|package.json)$' || true)"

if [ -z "$STAGED_PROJECT_FILES" ]; then
  echo -e "${YELLOW}暂存区无前端/配置文件，跳过 npm run check${NC}"
else
  echo "==> 运行项目检查 (npm run check)..."
  if ! npm run check; then
    echo -e "${RED}项目检查未通过${NC}"
    PASS=false
  else
    echo -e "${GREEN}项目检查通过${NC}"
  fi
fi

echo ""
if [ "$PASS" = true ]; then
  echo -e "${GREEN}所有检查通过 ✓${NC}"
  exit 0
else
  echo -e "${RED}提交被拦截 ✗ 请先修复上述问题${NC}"
  exit 1
fi
